{
  "name": "expo-adaptive-glass-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.24",
    "expo-adaptive-glass": "file:..",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "ios": "npm --prefix .. run prepare && expo run:ios",
    "ios:release": "npm --prefix .. run prepare && expo run:ios --configuration Release --no-bundler",
    "android": "npm --prefix .. run prepare && expo run:android",
    "android:release": "npm --prefix .. run prepare && expo run:android --variant release --no-bundler"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
